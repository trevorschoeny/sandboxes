{
  "schemaVersion": 1,
  "id": "sandboxes",
  "version": "${version}",
  "name": "Sandboxes",
  "description": "Creative-mode copies of your singleplayer world, for trying things without touching the real one.",
  "authors": [
    "trevorschoeny"
  ],
  "license": "MIT",
  "icon": "assets/sandboxes/icon.png",
  "environment": "client",
  "mixins": [
    "sandboxes.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "com.trevorschoeny.sandboxes.SandboxesClient"
    ],
    "modmenu": [
      "com.trevorschoeny.sandboxes.config.SandboxesConfigModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.2.0 <8.0.0"
  },
  "suggests": {
    "modmenu": "*",
    "keybindery": ">=1.3.0"
  }
}
