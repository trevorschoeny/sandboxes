{
  "schemaVersion": 1,
  "id": "sandboxes",
  "version": "${version}",
  "name": "Sandboxes",
  "description": "Make a creative copy of your world from the pause menu, try anything in it, and return to survival where you left off.",
  "authors": [
    "trevorschoeny"
  ],
  "license": "MIT",
  "icon": "assets/sandboxes/icon.png",
  "environment": "client",
  "mixins": [
    "sandboxes.mixins.json"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/sandboxes",
    "sources": "https://github.com/trevorschoeny/sandboxes",
    "issues": "https://github.com/trevorschoeny/sandboxes/issues"
  },
  "entrypoints": {
    "client": [
      "com.trevorschoeny.sandboxes.SandboxesClient"
    ],
    "modmenu": [
      "com.trevorschoeny.sandboxes.config.SandboxesConfigModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.3.0 <8.0.0"
  },
  "suggests": {
    "modmenu": "*",
    "keybindery": ">=1.3.0"
  }
}
